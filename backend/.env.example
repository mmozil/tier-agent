# Tier Agent control plane env vars

# ---- App ----
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8100

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tier_agent
DB_POOL_SIZE=10
DB_POOL_OVERFLOW=20

# ---- Redis ----
REDIS_URL=redis://localhost:6379/3

# ---- Auth ----
JWT_SECRET=change-me-in-prod-min-32-chars
JWT_ALGORITHM=HS256
JWT_TTL_HOURS=24
FERNET_KEY=  # generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ---- SSO Tier (opcional, pra cross-subdomain) ----
TIER_SSO_COOKIE_DOMAIN=.tier.finance
TIER_SSO_COOKIE_NAME=tier_session

# ---- Storage Cloudflare R2 ----
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_NAME=tier-agent
R2_PUBLIC_URL=

# ---- Docker orchestration ----
DOCKER_HOST=unix:///var/run/docker.sock
HERMES_IMAGE=tier/hermes:0.14.0-tier1
HERMES_PORT_RANGE_START=7100
HERMES_PORT_RANGE_END=9100

# ---- Tier WhatsApp Engine bridge ----
TIER_WHATSAPP_ENGINE_URL=https://whats.tier.finance
TIER_WHATSAPP_ENGINE_ADMIN_KEY=
TIER_WHATSAPP_WEBHOOK_SECRET=

# ---- Tier Pay (billing) ----
TIER_PAY_API_URL=https://api.tier.finance
TIER_PAY_INTERNAL_KEY=
TIER_AGENT_SKU_STARTER_PLAN_ID=
TIER_AGENT_SKU_PRO_PLAN_ID=
TIER_AGENT_SKU_BUSINESS_PLAN_ID=

# ---- Voice ----
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_DEFAULT_VOICE=pt-BR-Wavenet-A

# ---- Default LLM provider (apenas pro bootstrap; depois cliente cadastra no painel) ----
DEFAULT_LLM_PROVIDER=minimax
DEFAULT_LLM_MODEL=MiniMax-M2
DEFAULT_LLM_API_KEY=
